generator client {
  provider = "prisma-client-js"
  // "native" covers local development. Netlify (and most serverless hosts) run
  // functions on AWS Lambda with OpenSSL 3, and Prisma ships a different query
  // engine binary for that target — without it listed here the deployed
  // functions fail at runtime with "Query engine binary could not be found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String?
  image                  String?
  accessToken            String? // Google OAuth token, for API calls
  refreshToken           String?
  extensionTokenHash     String? // sha256 of the current extension bearer token; clearing/rotating revokes it
  extensionTokenIssuedAt DateTime?
  rollNumber             String? // student-editable; used by /api/format's cover page
  program                String? // student-editable; used by /api/format's cover page
  alertsEnabled          Boolean   @default(true) // deadline-alert opt-out (Settings > Notifications)
  alertLeadHours         Int       @default(48) // how far ahead of a due date to alert
  createdAt              DateTime  @default(now())
  courses                Course[]
}

model Course {
  id                 String         @id // Google's courseId
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  name               String
  section            String?
  descriptionHeading String?
  room               String?
  ownerName          String?
  assignments        Assignment[]
  announcements      Announcement[]
  teachers           Teacher[]
  syncedAt           DateTime       @default(now())
}

model Assignment {
  id            String       @id // Google's courseWork id
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id])
  title         String
  description   String?
  dueDate       DateTime?
  maxPoints     Float? // courseWork.maxPoints from Classroom — needed to turn assignedGrade into a percentage
  state         String? // PUBLISHED, DRAFT, etc.
  alternateLink String?
  driveFileIds  String[] // Drive file IDs from coursework materials, if any
  submissions   Submission[]
  syncedAt      DateTime     @default(now())
}

model Submission {
  id            String     @id // Google studentSubmission id
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  userId        String
  assignedGrade Float? // null until teacher grades it
  state         String? // TURNED_IN, RETURNED, etc.
  late          Boolean?   @default(false)
  syncedAt      DateTime   @default(now())
}

model Teacher {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  googleId String // teacher's Google userId
  name     String
  email    String? // requires classroom.profile.emails scope
  photoUrl String?
  syncedAt DateTime @default(now())

  @@unique([courseId, googleId])
}

model AlertLog {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  alertedAt    DateTime @default(now())

  @@unique([assignmentId, userId])
}

model Quiz {
  id                 String         @id @default(cuid())
  userId             String
  courseId           String?
  sourceAssignmentId String?
  title              String
  // Null until the owner explicitly shares. A separate 128-bit random value
  // rather than the primary key, so a share link is an unguessable capability
  // and quizzes are not readable by id enumeration.
  shareId            String?        @unique
  createdAt          DateTime       @default(now())
  questions          QuizQuestion[]
  attempts           QuizAttempt[]
}

model QuizQuestion {
  id            String  @id @default(cuid())
  quizId        String
  quiz          Quiz    @relation(fields: [quizId], references: [id])
  question      String
  options       Json // array of choices
  correctAnswer String
  explanation   String?
}

model QuizAttempt {
  id      String   @id @default(cuid())
  quizId  String
  quiz    Quiz     @relation(fields: [quizId], references: [id])
  userId  String
  score   Int
  answers Json // student's chosen answers
  takenAt DateTime @default(now())
}

// Sliding-window call counter for per-user AI rate limiting (6.4.4).
model ApiUsage {
  id        String   @id @default(cuid())
  userId    String
  route     String
  createdAt DateTime @default(now())

  @@index([userId, route, createdAt])
}

model Document {
  id            String   @id @default(cuid())
  userId        String // no @relation, same as Quiz/Submission/etc. — sidesteps FK cascade handling on account delete
  filename      String
  mimeType      String
  size          Int // bytes
  status        String // QUEUED, PARSING, READY, UNSUPPORTED, FAILED
  extractedText String? // capped length — see lib/documentParse.ts
  wordCount     Int?
  pageCount     Int?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Announcement {
  id            String    @id
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  text          String?
  alternateLink String?
  createdAt     DateTime?
  syncedAt      DateTime  @default(now())
}
