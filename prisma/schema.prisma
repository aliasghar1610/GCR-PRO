generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  accessToken  String? // Google OAuth token, for API calls
  refreshToken String?
  createdAt    DateTime @default(now())
  courses      Course[]
}

model Course {
  id                 String         @id // Google's courseId
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  name               String
  section            String?
  descriptionHeading String?
  room               String?
  ownerName          String?
  assignments        Assignment[]
  announcements      Announcement[]
  teachers           Teacher[]
  syncedAt           DateTime       @default(now())
}

model Assignment {
  id            String       @id // Google's courseWork id
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id])
  title         String
  description   String?
  dueDate       DateTime?
  state         String? // PUBLISHED, DRAFT, etc.
  alternateLink String?
  driveFileIds  String[] // Drive file IDs from coursework materials, if any
  submissions   Submission[]
  syncedAt      DateTime     @default(now())
}

model Submission {
  id            String     @id // Google studentSubmission id
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  userId        String
  assignedGrade Float? // null until teacher grades it
  state         String? // TURNED_IN, RETURNED, etc.
  late          Boolean?   @default(false)
  syncedAt      DateTime   @default(now())
}

model Teacher {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  googleId String // teacher's Google userId
  name     String
  email    String? // requires classroom.profile.emails scope
  photoUrl String?
  syncedAt DateTime @default(now())

  @@unique([courseId, googleId])
}

model AlertLog {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  alertedAt    DateTime @default(now())

  @@unique([assignmentId, userId])
}

model Quiz {
  id                 String         @id @default(cuid())
  userId             String
  courseId           String?
  sourceAssignmentId String?
  title              String
  createdAt          DateTime       @default(now())
  questions          QuizQuestion[]
  attempts           QuizAttempt[]
}

model QuizQuestion {
  id            String  @id @default(cuid())
  quizId        String
  quiz          Quiz    @relation(fields: [quizId], references: [id])
  question      String
  options       Json // array of choices
  correctAnswer String
  explanation   String?
}

model QuizAttempt {
  id      String   @id @default(cuid())
  quizId  String
  quiz    Quiz     @relation(fields: [quizId], references: [id])
  userId  String
  score   Int
  answers Json // student's chosen answers
  takenAt DateTime @default(now())
}

model Announcement {
  id            String    @id
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  text          String?
  alternateLink String?
  createdAt     DateTime?
  syncedAt      DateTime  @default(now())
}
