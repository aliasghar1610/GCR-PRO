# Copy to .env and fill in. Never commit the filled-in file.
# Production must use its own values — a separate Google OAuth client, a
# separate database, and freshly generated secrets.

# --- Database -----------------------------------------------------------
# Supabase Postgres. On serverless (Vercel), use the pooled connection string
# (port 6543, ?pgbouncer=true) rather than the direct 5432 one.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# --- Google OAuth -------------------------------------------------------
# From Google Cloud Console. The authorized redirect URI must be
# <NEXTAUTH_URL>/api/auth/callback/google — no wildcards, and no localhost
# entries on the production client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- NextAuth -----------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET=""
# Must be the real https:// origin in production — NextAuth derives cookie
# security (the __Secure- prefix) from this.
NEXTAUTH_URL="http://localhost:3000"

# --- Encryption for stored Google tokens (lib/tokenCrypto.ts) -----------
# Exactly 32 bytes, base64: openssl rand -base64 32
# Rotating this invalidates every stored Google token and forces re-consent.
TOKEN_ENCRYPTION_KEY=""

# --- Chrome extension bearer tokens (lib/extensionAuth.ts) --------------
# Deliberately separate from NEXTAUTH_SECRET: openssl rand -base64 32
EXTENSION_JWT_SECRET=""

# --- AI -----------------------------------------------------------------
GEMINI_API_KEY=""
# Optional override if the default model is retired.
# GEMINI_MODEL="gemini-3.6-flash"

# --- Email (Resend) -----------------------------------------------------
# Used only for outbound deadline-alert emails. The app requests no Gmail
# scope and has no access to any user's mailbox.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend. The default below is
# Resend's test sender, which only delivers to your own account address.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- Deadline alert cron ------------------------------------------------
# Sent as `Authorization: Bearer <CRON_SECRET>` to /api/alerts/check.
CRON_SECRET=""

# --- Chrome extension ---------------------------------------------------
# The unpacked/published extension id. Must match the origin allowed for CORS
# in proxy.ts and the API_BASE in extension/background.js.
EXTENSION_ID=""
NEXT_PUBLIC_EXTENSION_ID=""

# --- Google Picker (client-side, public by design) ----------------------
# NEXT_PUBLIC_* values are inlined into the browser bundle. The API key must be
# restricted by HTTP referrer in Google Cloud Console so it is only usable from
# your own origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_API_KEY=""
